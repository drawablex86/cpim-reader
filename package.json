{
  "name": "cpim-documents-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build:pagefind": "npx pagefind --site build --output-path static/pagefind && cp -r static/pagefind build/",
    "build": "vite build && npm run build:pagefind",
    "preview": "vite preview",
    "sync": "python3 scripts/sync.py",
    "embed": "python3 scripts/embed.py",
    "classify": "python3 scripts/classify_documents.py",
    "fortify": "python3 scripts/fortify_tags.py",
    "pdfs": "python3 scripts/publish_pdfs.py"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.2",
    "@sveltejs/kit": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "mdsvex": "^0.12.3",
    "pagefind": "^1.1.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "svelte": "^5.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1"
  }
}
